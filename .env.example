# Deep Diligence Agent — configuration.
#
# Copy to .env and set ONE model provider. With nothing set, the agent
# runs on the labelled offline stub model over the bundled corpus —
# that is what the tests, evals, and demo use.

# --- Model provider (pick one) ---
# OpenAI-compatible: OpenAI itself, NVIDIA NIM hosted
# (OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1) or a
# self-hosted NIM container (http://localhost:8000/v1), vLLM, etc.
LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.1

# Anthropic:
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Ollama (local, OpenAI-compatible surface):
# LLM_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# Offline stub (no key, deterministic):
# LLM_BACKEND=offline

# --- Harness profile ---
# The profile artifact (profiles/<id>.json) that shapes the harness
# build: prompt composition, per-role tool allowlists, sub-agent
# roster, middleware switches. Selected by configuration, validated
# at startup — an invalid profile refuses startup. Default:
# offline-stub (the behaviour tests and evals pin). The profile is
# configuration, independent of the model provider above; a real
# deployment pairs the profile with the model it targets.
# PROFILE_ID=offline-stub
# PROFILE_DIR=profiles

# --- Cost accounting ---
# Where the governed price table lives (pricing/price-table.json in
# the repo by default): per-model input/output rates as versioned
# data, validated at startup like the profile. A run's cost is
# priced against the table as it stands when the run ends and
# recorded on the case with the table version and rates used, so
# pointing this at a newer table re-prices nothing historical.
# PRICING_DIR=pricing

# --- Skills library ---
# Where the shipped skill artifacts live (skills/ in the repo by
# default): governed method bundles as versioned JSON, validated
# and seeded into the store at startup. Later versions are
# published through the API into the store — publishing never
# writes files — so a deployment's library lives with its data
# and this directory remains the seed set.
# SKILLS_DIR=skills

# --- Source governance ---
# Days a standard-retention case is kept before the retention sweep
# lists it for an analyst's deletion decision. The sweep lists only;
# deletion is a recorded per-case act, and a case under legal hold
# refuses it. Default: 365.
# RETENTION_DAYS=365

# --- Stores (production profile) ---
# PostgreSQL case store. Unset = SQLite at SQLITE_PATH.
# DATABASE_URL=postgresql://diligence:diligence@localhost:5432/diligence
# SQLITE_PATH=./data/diligence.db

# S3-compatible object storage for evidence originals and case files.
# Unset = local directory at OBJECT_DIR. Compose sets these for the
# SeaweedFS service (hostname minio, S3 gateway on 8333).
# S3_ENDPOINT_URL=http://localhost:8333
# S3_BUCKET=diligence-evidence
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_REGION=us-east-1
# OBJECT_DIR=./data/objects

# Optional: require this key in the X-API-Key header on write endpoints.
# API_KEY=
